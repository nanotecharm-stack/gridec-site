# Normalise line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Treat binary assets as binary (no EOL conversion)
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.ttf binary
*.woff2 binary

# Сторонние библиотеки поля героя: хранить как есть, не трогать переводы строк.
# Их подпись и размер должны совпадать с тем, что выложено на сайт.
vendor/** -text
